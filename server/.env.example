PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# Development/test only. Production must set an explicitly supported real provider and must never use mock.
PAYMENT_PROVIDER=mock
# Legacy Paytm placeholders retained for compatibility until a provider adapter is installed.
PAYTM_MERCHANT_ID=
PAYTM_CLIENT_ID=
PAYTM_CLIENT_SECRET=
PAYTM_WEBSITE=
PAYTM_CALLBACK_URL=
PAYTM_WEBHOOK_SECRET=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GLOBAL_RATE_LIMIT=120
TRUST_PROXY=false

# Server-only key used for authenticated vehicle image uploads. Never expose this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage bucket for public customer-facing vehicle images.
SUPABASE_VEHICLE_IMAGE_BUCKET=vehicle-images

# Booking cancellation policy (server-authoritative; configure business policy explicitly)
CANCELLATION_CUTOFF_HOURS=24
CANCELLATION_FEE_PERCENT=0
CANCELLATION_REFUND_PLATFORM_FEE=false

# Maps / routing (server-only; never expose these in EXPO_PUBLIC_*).
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
ROUTE_CACHE_TTL_MS=120000
ROUTE_TIMEOUT_MS=8000
GEOCODE_CACHE_TTL_MS=600000
GEOCODE_TIMEOUT_MS=8000

# Expo mobile map keys are public/restricted keys, configured in app.config.js.
# Restrict Android by com.rideon.app + Android Maps SDK and iOS by com.rideon.app + Maps SDK for iOS.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Active delivery tracking (server).
TRACKING_SESSION_MAX_MINUTES=180
TRACKING_STALE_SECONDS=90
TRACKING_ROUTE_REFRESH_SECONDS=60
TRACKING_ROUTE_REFRESH_METERS=300

# Optional Expo public delivery-device tuning.
# EXPO_PUBLIC_TRACKING_INTERVAL_MS=10000
# EXPO_PUBLIC_TRACKING_DISTANCE_METERS=50
