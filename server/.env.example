PORT=4000
NODE_ENV=development
# Production must set DATABASE_URL; the API refuses to boot without it.
# Set NODE_ENV=production in the deployed server.
CLIENT_ORIGIN=*
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Required for authenticated production use. Use a long random value.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# India-first payment provider. Use `unconfigured` for local flows without payments.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Legacy generic name is accepted as a fallback for webhook verification only.
PAYMENT_WEBHOOK_SECRET=

# Explicitly set these in staging/production; never commit actual values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GLOBAL_RATE_LIMIT=120
TRUST_PROXY=false
