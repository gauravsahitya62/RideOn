PORT=4000
NODE_ENV=development
# Production must set DATABASE_URL; the API refuses to boot without it.
# Set NODE_ENV=production in the deployed server.
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Required for authenticated production use. Use a long random value.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# India-first payment provider. Required in production. Use `unconfigured` only for local development.
PAYMENT_PROVIDER=unconfigured
UPI_VPA=
UPI_MERCHANT_NAME=RideOn
UPI_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Explicitly set these in staging/production; never commit actual values.
# Render production must set PAYMENT_PROVIDER=upi, UPI_VPA, and UPI_WEBHOOK_SECRET before deploy.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GLOBAL_RATE_LIMIT=120
TRUST_PROXY=false
