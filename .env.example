# RideOn environment reference — no real secrets belong in this file.
# Local development:
#   NODE_ENV=development
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#   EXPO_PUBLIC_USE_LOCAL_API=true
#   PAYMENT_PROVIDER=mock (server only; local/test only)
#
# Production:
#   NODE_ENV=production
#   EXPO_PUBLIC_API_URL=https://<your-render-service>.onrender.com
#   EXPO_PUBLIC_USE_LOCAL_API=false (or omit)
#   PAYMENT_PROVIDER=paytm (server only)
#   Server secrets below are configured only in Render, never in Expo.
#
# Expo public variables are embedded into the mobile binary. Only use values that
# are intentionally public/restricted: API base URL, Supabase publishable key/URL,
# and platform-restricted Google Maps SDK keys.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_USE_LOCAL_API=true
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Optional compatibility fallback; production should prefer two platform-restricted keys.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_TRACKING_INTERVAL_MS=10000
EXPO_PUBLIC_TRACKING_DISTANCE_METERS=50

TRUST_PROXY=false
GLOBAL_RATE_LIMIT=120
ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# Database — Render/server only
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# RideOn / Supabase Auth — server-side publishable configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
JWT_SECRET=

# Payment — server only; mock is local/test only
PAYMENT_PROVIDER=mock
PAYTM_MERCHANT_ID=
PAYTM_CLIENT_ID=
PAYTM_CLIENT_SECRET=
PAYTM_WEBSITE=
PAYTM_CALLBACK_URL=
PAYTM_WEBHOOK_SECRET=

# Maps/routing — server-side secrets stay on Render
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# OTP delivery (production/server)
RESEND_API_KEY=
OTP_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Delivery tracking (server)
TRACKING_SESSION_MAX_MINUTES=180
TRACKING_STALE_SECONDS=90
TRACKING_ROUTE_REFRESH_SECONDS=60
TRACKING_ROUTE_REFRESH_METERS=300
