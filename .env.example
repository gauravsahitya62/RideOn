# RideOn environment reference — no real secrets belong in this file.
# Local development:
#   NODE_ENV=development
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#   PAYMENT_PROVIDER=mock (local only)
#
# Staging/test:
#   Use a dedicated Supabase project, PostgreSQL database, payment credentials,
#   maps keys and CLIENT_ORIGIN. Never reuse production secrets.
#
# Production:
#   NODE_ENV=production
#   EXPO_PUBLIC_API_URL=https://<your-render-service>.onrender.com
#   PAYMENT_PROVIDER=paytm
#   All server secrets below are configured only in Render, never in Expo.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8081
EXPO_PUBLIC_USE_LOCAL_API=true
TRUST_PROXY=false
GLOBAL_RATE_LIMIT=120
ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_ROUNDS=12

# Database
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# RideOn / Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
JWT_SECRET=

# Payment — required in production
PAYMENT_PROVIDER=mock
PAYTM_MERCHANT_ID=
PAYTM_CLIENT_ID=
PAYTM_CLIENT_SECRET=
PAYTM_WEBSITE=
PAYTM_CALLBACK_URL=
PAYTM_WEBHOOK_SECRET=

# Maps/routing — server-side secrets stay on Render
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# OTP delivery (production)
RESEND_API_KEY=
OTP_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Delivery tracking
TRACKING_SESSION_MAX_MINUTES=180
TRACKING_ROUTE_REFRESH_SECONDS=60
TRACKING_ROUTE_REFRESH_METERS=300
